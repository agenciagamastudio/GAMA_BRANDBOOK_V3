{
  "name": "gama-grupo-vip",
  "version": "0.1.0",
  "private": true,
  "description": "Agregador nichado de peças de moto — ingere Shopee + Mercado Livre, filtra por modelo, dispara 1x/dia no WhatsApp pessoal via Evolution API.",
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "echo \"Etapa 3: vitest configurado nas stories seguintes\" && exit 0",
    "lint": "echo \"Etapa 4: eslint + prettier configurados nas stories seguintes\" && exit 0",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:test": "ts-node scripts/test-db.ts",
    "db:apply-sql": "psql -U $POSTGRES_USER -d $POSTGRES_DB -f src/db/migrations/001_init.sql",
    "ingest": "echo \"Story 1.8 implementa ingest CLI\" && exit 0",
    "dispatch": "echo \"Story 1.8 implementa dispatch CLI\" && exit 0",
    "cron:test": "echo \"Story 1.3 implementa cron scaffold\" && exit 0",
    "evolution:create": "echo \"Story 1.6 implementa create instance\" && exit 0",
    "evolution:qr": "echo \"Story 1.6 implementa QR code read\" && exit 0",
    "evolution:list-groups": "echo \"Story 1.6 implementa list groups\" && exit 0"
  },
  "keywords": [
    "aggregator",
    "whatsapp",
    "evolution-api",
    "shopee",
    "mercadolivre",
    "moto-parts"
  ],
  "author": "@prontoatendimentogama",
  "license": "UNLICENSED",
  "dependencies": {
    "bullmq": "^5.21.2",
    "drizzle-orm": "^0.36.4",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
