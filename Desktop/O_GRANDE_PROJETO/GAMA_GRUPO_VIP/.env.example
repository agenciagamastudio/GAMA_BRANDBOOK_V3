# === Ambiente ===
NODE_ENV=development
LOG_LEVEL=info
TZ=America/Sao_Paulo

# === Postgres 16 (Story 1.2) ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gama_vip
POSTGRES_USER=gama
POSTGRES_PASSWORD=change-me

# === Dragonfly / Redis drop-in (Story 1.3) ===
REDIS_HOST=dragonfly
REDIS_PORT=6379

# === Evolution API (WhatsApp) — preencher após Story 1.6 ===
EVOLUTION_URL=http://evolution:8080
EVOLUTION_APIKEY=fill-after-create
EVOLUTION_INSTANCE=gama-vip
EVOLUTION_GROUP_JID=fill-after-first-list

# === Telegram (Story 3.3) — opcional v1 ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# === Shopee Open Platform (Story 1.4) ===
SHOPEE_AFFILIATE_ID=
SHOPEE_API_TOKEN=

# === Mercado Livre Product Advertising API (Story 1.5) ===
ML_AFFILIATE_ID=
ML_API_TOKEN=

# === Cron (Story 1.3, 2.7) ===
DISPATCH_CRON=30 8 * * *
MAX_PER_DAY=20

# === Healthcheck server (Story 3.2) ===
HEALTH_PORT=8080

# === Scrapers (Story 3.1) ===
SCRAPER_MAGALU_ENABLED=true
SCRAPER_AMERICANAS_ENABLED=true
REQ_DELAY_MS=3000
